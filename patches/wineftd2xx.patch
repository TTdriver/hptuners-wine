 //a list of FTD product ids to access (in hexidecimal)
 #define FTDprodVar "FTDID"
+
+/* Translate receive notifications to Wine events. Linux D2XX event objects
+ * cannot accept Windows HANDLEs. This experimental adapter supports RX only. */
+typedef struct {
+  FT_HANDLE device;
+  HANDLE event, thread;
+  volatile LONG stop;
+} wine_rx_notification;
+static wine_rx_notification notifications[16];
+static SRWLOCK notification_lock = SRWLOCK_INIT;
+
+static DWORD WINAPI rx_notify_thread(LPVOID argument)
+{
+  wine_rx_notification *entry = argument;
+  while (!InterlockedCompareExchange(&entry->stop, 0, 0)) {
+    DWORD available = 0;
+    FT_STATUS status = xFT_GetQueueStatus(entry->device, &available);
+    if (status != FT_OK) break;
+    if (available && !SetEvent(entry->event)) break;
+    Sleep(10);
+  }
+  return 0;
+}
+
+/* Called under the exclusive notification lock, before closing the device. */
+static void stop_notification(wine_rx_notification *entry)
+{
+  InterlockedExchange(&entry->stop, 1);
+  WaitForSingleObject(entry->thread, INFINITE);
+  CloseHandle(entry->thread);
+  entry->thread = NULL;
+  entry->device = NULL;
+}
+
+static void remove_notification(FT_HANDLE device)
+{
+  unsigned i;
+  AcquireSRWLockExclusive(&notification_lock);
+  for (i = 0; i < 16; ++i)
+    if (notifications[i].thread && notifications[i].device == device)
+      stop_notification(&notifications[i]);
+  ReleaseSRWLockExclusive(&notification_lock);
+}
+
 
 
